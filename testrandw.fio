[global]
;指定测试目录
directory=/mnt/nvme/
;启用直接IO
direct=1
;单次io的大小，这里设置为4k
bs=4k
;每个线程读写的数据量为1G
size=1g
;每个任务开2个线程
numjobs=2
;使用线程进行测试
thread
;这里不指定测试时间，直到所有的IO操作结束后自动停止
;runtime
;同步IO
ioengine=libaio
;io队列的深度设定为32
iodepth=32
;报告结果
group_reporting

;测试随机写
[test_randwrite1]
new_group
filename=tf1
rw=randwrite

